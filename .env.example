# ============================================================
# 服务器监控面板 - 环境变量示例
# ============================================================
# 用法：
#     cp .env.example .env
#     然后填入真实值。.env 已被 .gitignore 排除，不会进入版本库。
#
# 优先级：环境变量 > configs/app.yaml
# 因此这里配置的值会覆盖配置文件中的同名项。
# ============================================================


# ---------- 管理员账号 ----------
# 首次启动时用于创建默认管理员；账号已存在则忽略
ADMIN_USERNAME=admin
# 强烈建议修改。留空会导致无法登录
ADMIN_PASSWORD=


# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=server_monitor
# 连接池配置（可选）
MYSQL_POOL_SIZE=10
MYSQL_POOL_RECYCLE=1800


# ---------- Redis ----------
# 用于会话存储、限流计数、告警抑制持久化
# 留空 HOST 则跳过 Redis，降级为纯内存模式（单实例可用）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PREFIX=srvmon:


# ---------- 日志 ----------
# DEBUG: 全量调试信息 | INFO: 常规 | WARNING: 仅告警与错误
LOG_LEVEL=INFO


# ---------- 安全 ----------
# 会话 Cookie 是否标记 secure（仅 HTTPS 传输）
# 本地 HTTP 调试必须为 false，否则浏览器不保存 Cookie，
# 表现为"登录后立刻被踢回登录页"。
# 生产环境（HTTPS）请设为 true。
COOKIE_SECURE=false

# 可信主机白名单（逗号分隔），防止 Host 头攻击。
# 留空则不启用该校验。本地调试可留空。
ALLOWED_HOSTS=

# CORS 允许来源（逗号分隔）。
# 前后端同源部署时留空即可（本项目默认）。需要跨域时填明确来源，
# 不要用 "*" —— 与 allow_credentials 组合会被浏览器拒绝。
CORS_ALLOWED_ORIGINS=


# ---------- 默认通知渠道（可选） ----------
# 五项全部填写后，首次启动会自动创建一个邮箱通知渠道。
# 任意一项留空则跳过创建，可在面板「通知 → 通知渠道」里手动添加。
DEFAULT_EMAIL_NAME=默认邮箱
DEFAULT_SMTP_HOST=smtp.qq.com
DEFAULT_SMTP_PORT=465
DEFAULT_SMTP_SSL=true
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASSWORD=
# 多个收件人用逗号分隔
DEFAULT_EMAIL_RECIPIENTS=
